{
  "Jwt": {
    "Secret": "autoparts-super-secret-key-minimum-32-characters!",
    "Issuer": "autoparts-gateway",
    "Audience": "autoparts-client",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/parts/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/stock/{**catch-all}"
        }
      },
      "notifications-hub-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {            
            "Address": "http://catalog-api:8080"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {           
            "Address": "http://orders-api:8080"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://inventory-api:8080"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notifications-api:8080"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}